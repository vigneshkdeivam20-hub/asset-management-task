{
  "name": "asset-management",
  "version": "1.0.0",
  "private": true,
  "description": "Starter scaffold for an asset management application",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test",
    "migrate:generate": "sequelize-cli migration:generate",
    "migrate:up": "sequelize-cli db:migrate --env development",
    "migrate:undo": "sequelize-cli db:migrate:undo --env development"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "datatables.net": "^3.1.4",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jade": "^1.11.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.5"
  }
}
