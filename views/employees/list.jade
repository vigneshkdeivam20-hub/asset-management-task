extends ../layouts/main

block content
  .container.my-4
    h1 Employees
    if error
      div.alert.alert-danger= error
    form(method='GET', action='/employees/search', class='mb-3')
      div.input-group
        input.form-control(type='text', name='searchTerm', placeholder='Search employees...')
        button.btn.btn-primary(type='submit') Search
    table#employeeTable.table.table-striped.table-hover
      thead
        tr
          th Employee Code
          th First Name
          th Last Name
          th Email
          th Status
          th Branch
          th Actions
      tbody
        each employee in employees
          tr
            td= employee.employeeCode
            td= employee.firstName
            td= employee.lastName
            td= employee.email
            td= employee.status
            td= employee.Branch?.name || 'None'
            td
              a.btn.btn-sm.btn-primary(href='/employees/#{employee.id}/edit') Edit
              form(method='POST', action='/employees/#{employee.id}/delete')
                button.btn.btn-sm.btn-danger(type='submit') Delete
    a.btn.btn-success(href='/employees/create') Create Employee